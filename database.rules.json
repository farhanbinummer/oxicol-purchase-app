{
  "rules": {
    ".read": false,
    ".write": false,
    "taskflow": {

      "authIndex": {
        "$username": {
          ".read": true,
          ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },

      "users": {
        ".read": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },

      "admin": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "admins": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "branches": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },

      "members": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'",
        "$memberId": {
          "$field": {
            ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/id').val() === $memberId && root.child('taskflow/users/' + auth.uid + '/role').val() === 'member' && ($field === 'name' || $field === 'phone' || $field === 'avatarUrl' || $field === 'passwordHash')"
          }
        }
      },

      "products": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "counters": { ".read": "auth != null", ".write": "auth != null" },
      "appSettings": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "stockDiffs": { ".read": "auth != null", ".write": "auth != null" },
      "stockPlaces": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('taskflow/users/' + auth.uid + '/role').val() === 'admin'"
      },

      "tasks":         { ".read": "auth != null", ".write": "auth != null" },
      "archivedTasks": { ".read": "auth != null", ".write": "auth != null" },
      "chats":         { ".read": "auth != null", ".write": "auth != null" },
      "branchOrders":  { ".read": "auth != null", ".write": "auth != null" },
      "templates":     { ".read": "auth != null", ".write": "auth != null" },
      "announcements": { ".read": "auth != null", ".write": "auth != null" },
      "notifications": { ".read": "auth != null", ".write": "auth != null" },
      "activityLogs":  { ".read": "auth != null", ".write": "auth != null" }
    }
  }
}
