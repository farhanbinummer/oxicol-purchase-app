# Copy this file to ".env" and fill in your values. Never commit .env.
PORT=3000

# PostgreSQL connection (password = the one you set during PostgreSQL install)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oxicol
DB_USER=postgres
DB_PASSWORD=your_password_here

# GST rates in percent (used by the PO API from Tuesday)
CGST_RATE=9
SGST_RATE=9

# TallyPrime ledger names (must match your Tally company). Used by /api/tally/sync
TALLY_BANK_LEDGER=Bank Account
TALLY_ADVANCE_LEDGER=Advance to Suppliers

# ---- TaskFlow (the separate task app) -------------------------------------------------------------------------
# The "Tasks" link in the sidebar. Not set = the default address below. Set but EMPTY = no link is shown. Must be https.
TASK_APP_URL=https://steady-frangollo-e2886d.netlify.app/

# Read-only task numbers on the Manager and Administrator dashboards (overdue, open, due today, done in 7 days).
# All FOUR must be set or the card is simply not shown. Counts only: no task title, description or chat is ever copied.
# Use ONE dedicated reader account that only Oxicol uses (see docs/TASKFLOW.md). Keep the password in the Render
# Environment settings only: never commit it, paste it in chat or put it in this file.
TASKFLOW_FIREBASE_API_KEY=
TASKFLOW_DATABASE_URL=
TASKFLOW_READER_EMAIL=
TASKFLOW_READER_PASSWORD=
