# Copy this file to ".env" and fill in your values. Never commit .env.
PORT=3000

# PostgreSQL connection (password = the one you set during PostgreSQL install)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oxicol
DB_USER=postgres
DB_PASSWORD=your_password_here

# GST rates in percent (used by the PO API from Tuesday)
CGST_RATE=9
SGST_RATE=9

# TallyPrime ledger names (must match your Tally company). Used by /api/tally/sync
TALLY_BANK_LEDGER=Bank Account
TALLY_ADVANCE_LEDGER=Advance to Suppliers
